  "dependencies": {
    "@hono/node-server": "1.13.0",
    "@tansui/core": "workspace:*",
    "@tansui/types": "workspace:*",
    "bullmq": "5.67.2",
    "dotenv": "16.4.7",
    "hono": "4.6.12",
    "ioredis": "5.4.2",
    "node-telegram-bot-api": "0.67.0"
  },
  "devDependencies": {
    "@types/node-telegram-bot-api": "0.64.13"
  }
