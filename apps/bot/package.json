{
  "name": "@tansui/bot",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "set-webhook": "node dist/scripts/set-webhook.js",
    "delete-webhook": "node dist/scripts/delete-webhook.js",
    "get-webhook-info": "node dist/scripts/get-webhook-info.js",
    "lint": "eslint src --ext .ts"
